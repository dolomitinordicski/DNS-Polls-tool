rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'management@dolomitinordicski.com';
    }

    function validResponse(responseId) {
      return
        request.resource.data.keys().hasOnly([
          'id', 'name', 'firstName', 'lastName', 'votes', 'updatedAt'
        ])
        && request.resource.data.id == responseId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.votes is map
        && request.resource.data.updatedAt is string;
    }

    function validPrivateContact() {
      return
        request.resource.data.keys().hasOnly([
          'participantId', 'email', 'firstName', 'lastName', 'updatedAt'
        ])
        && request.resource.data.participantId is string
        && request.resource.data.participantId.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.updatedAt is string;
    }

    match /polls/{pollId} {
      // TEMPORARY OPERATIONAL MODE.
      // DNS Polls must remain usable while the final DNS v.01 auth model is
      // defined. Poll definitions contain no participant private e-mail data.
      allow read: if true;
      allow create, update, delete: if true;

      match /responses/{responseId} {
        allow read: if true;
        allow create, update: if validResponse(responseId);

        // Required by the current open operational admin workflow.
        // Private participant e-mails are stored separately and are not exposed
        // by this collection.
        allow delete: if true;
      }

      match /privateContacts/{contactId} {
        // Participants may submit their own contact together with a response,
        // but private e-mail records are never publicly readable.
        allow create: if validPrivateContact();

        // Administrative access to private contacts remains authenticated even
        // while the poll-management UI itself is temporarily open.
        allow read, update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

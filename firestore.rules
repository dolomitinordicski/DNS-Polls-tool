rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'management@dolomitinordicski.com';
    }

    function validResponse(responseId) {
      return
        request.resource.data.keys().hasOnly([
          'id', 'name', 'firstName', 'lastName', 'votes', 'updatedAt'
        ])
        && request.resource.data.id == responseId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.votes is map
        && request.resource.data.updatedAt is string;
    }

    function validPrivateContact() {
      return
        request.resource.data.keys().hasOnly([
          'participantId', 'email', 'firstName', 'lastName', 'updatedAt'
        ])
        && request.resource.data.participantId is string
        && request.resource.data.participantId.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.updatedAt is string;
    }

    match /polls/{pollId} {
      // TEMPORARY OPERATIONAL MODE.
      // DNS Polls must remain usable while the final DNS v.01 auth model is
      // defined. Poll definitions contain no participant private e-mail data.
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      match /responses/{responseId} {
        allow read: if true;
        allow create, update: if validResponse(responseId);
        allow delete: if isAdmin();
      }

      match /privateContacts/{contactId} {
        function isCanonicalParticipantContact() {
          return contactId ==
            'participant-' + request.resource.data.participantId;
        }

        function participantResponseExistsAfter() {
          return existsAfter(
            /databases/$(database)/documents/polls/$(pollId)/responses/$(request.resource.data.participantId)
          );
        }

        // A participant can create only the canonical private-contact document
        // tied to the public response ID. Invitee-list records are admin-only.
        allow create: if validPrivateContact()
          && (
            isAdmin()
            || (
              isCanonicalParticipantContact()
              && participantResponseExistsAfter()
            )
          );

        // Public updates may refresh the same canonical record but may not
        // change its participant identity or e-mail address.
        allow update: if isAdmin()
          || (
            validPrivateContact()
            && isCanonicalParticipantContact()
            && participantResponseExistsAfter()
            && resource.data.participantId ==
              request.resource.data.participantId
            && resource.data.email == request.resource.data.email
          );

        allow read, delete: if isAdmin();
      }
    }

    // Events are independent of legacy date polls. Personal registrations
    // are never publicly readable, including by the registrant.
    match /events/{eventId} {
      allow get: if isAdmin() || resource.data.status in ['open', 'closed'];
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.id == eventId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.questions is list
        && request.resource.data.questions.size() <= 8
        && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();

      match /registrations/{registrationId} {
        allow read, delete: if isAdmin();
        allow update: if false;
        allow create: if
          get(/databases/$(database)/documents/events/$(eventId)).data.status == 'open'
          && request.resource.data.keys().hasOnly([
            'id', 'firstName', 'lastName', 'email', 'answers', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'firstName', 'lastName', 'email', 'answers', 'createdAt'
          ])
          && request.resource.data.id == registrationId
          && registrationId.size() >= 20
          && registrationId.size() <= 60
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() > 0
          && request.resource.data.firstName.size() <= 80
          && request.resource.data.lastName is string
          && request.resource.data.lastName.size() > 0
          && request.resource.data.lastName.size() <= 80
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+
      allow read, write: if false;
    }
  }
}
)
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 8
          && request.resource.data.createdAt is string;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

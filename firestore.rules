rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Administrative collection access remains authenticated. Public invitees
    // may read only a poll they already know by ID; they cannot enumerate polls.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'management@dolomitinordicski.com';
    }

    match /polls/{pollId} {
      // Public share links resolve a known poll ID. Full collection listing is
      // intentionally reserved for the DNS administrative session.
      allow get: if true;
      allow list: if isAdmin();

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt is string
      );

      match /responses/{responseId} {
        allow read: if true;

        allow create: if
          request.resource.data.keys().hasOnly([
            'id', 'name', 'firstName', 'lastName', 'votes', 'updatedAt'
          ])
          && request.resource.data.id == responseId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 160
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() <= 80
          && request.resource.data.lastName is string
          && request.resource.data.lastName.size() <= 80
          && request.resource.data.votes is map
          && request.resource.data.updatedAt is string;

        allow update, delete: if isAdmin();
      }

      match /privateContacts/{contactId} {
        allow read, update, delete: if isAdmin();

        allow create: if
          request.resource.data.keys().hasOnly([
            'participantId', 'email', 'firstName', 'lastName', 'updatedAt'
          ])
          && request.resource.data.participantId is string
          && request.resource.data.participantId.size() > 0
          && request.resource.data.email is string
          && request.resource.data.email.size() > 3
          && request.resource.data.email.size() <= 254
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() <= 80
          && request.resource.data.lastName is string
          && request.resource.data.lastName.size() <= 80
          && request.resource.data.updatedAt is string;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

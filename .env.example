# Firebase Web App configuration.
# These values are safe to expose in a browser bundle; access is controlled by
# Firestore Security Rules, not by hiding the web config.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Server-side AI integration (not exposed to GitHub Pages).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="YOUR_SERVER_APP_URL"
